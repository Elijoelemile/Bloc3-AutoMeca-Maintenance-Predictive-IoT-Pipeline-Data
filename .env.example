# Copier ce fichier en .env et renseigner les vraies valeurs.
# .env n'est jamais versionné (voir .gitignore).

# Kaggle (extraction batch)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Kafka (auto-hébergé, petite instance Compute — voir Bloc 2 pour la justification)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_TELEMETRIE=automeca.telemetrie

# MQTT (capteurs)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_TOPIC=automeca/capteurs/+/mesure

# PostgreSQL (staging + datamart — schema defini au Bloc 2)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=automeca
POSTGRES_USER=
POSTGRES_PASSWORD=

# ClickHouse (telemetrie, auto-heberge, petite instance Compute)
# Port HTTP simple (8123), pas HTTPS (8443) : pas de certificat TLS sur
# cette instance de demo temporaire — protection en transit assuree par
# le pare-feu reseau (acces restreint a l'IP du poste candidat), pas
# par le chiffrement. Voir README pour la justification complete.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=automeca
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Object Storage (data lake, S3-compatible)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=automeca-datalake
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Seuils d'alerte precoce (flux temps reel)
ALERT_RMS_VIBRATION_THRESHOLD=45.0
ALERT_PRESSURE_TREND_THRESHOLD=15.0

# RGPD (pseudonymisation des identites operateur)
PRIVACY_PSEUDONYMISATION_KEY=

# --- Variables utilisees UNIQUEMENT par docker-compose.yml (deploiement
# Kafka/ClickHouse/Grafana sur l'instance Compute) : ---

# IP publique de l'instance, pour le listener Kafka EXTERNAL (le
# pipeline local doit pouvoir joindre Kafka depuis l'exterieur)
KAFKA_PUBLIC_HOST=

# Identifiant de cluster KRaft (genere une seule fois, requis par l'image
# officielle Apache Kafka) : python3 -c "import uuid,base64; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
KAFKA_CLUSTER_ID=

# Mot de passe admin de l'interface web Grafana (port 3000)
GRAFANA_ADMIN_PASSWORD=
